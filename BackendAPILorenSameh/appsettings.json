{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Connection": "Server=localhost\\TomasServerSQL;Database=LornSameh;User Id=admin;Password=1234;TrustServerCertificate=True;"
  },

  "EmailSettings": {
    "MailServer": "smtp.gmail.com",
    "MailPort": 587,
    "SenderName": "Lost & Found",
    "SenderEmail": "YOUR_EMAIL@gmail.com",
    "Password": "YOUR_APP_PASSWORD",
    "EnableSsl": true
  },

  "Jwt": {
    "Key": "ReplaceThisWithAVeryLongRandomSecretKeyAtLeast32BytesLong123456789",
    "Issuer": "LostAndFoundAPI",
    "Audience": "LostAndFoundUsers",
    "DurationInMinutes": 60
  },

  "SessionSettings": {
    "RefreshTokenDays": 7,
    "IdleTimeoutMinutes": 120
  },

  "OtpSettings": {
    "OtpExpiryMinutes": 10,
    "MaxOtpAttempts": 3,
    "ResendCooldownMinutes": 2,
    "MailWindowDays": 30,
    "MaxMailsInWindow": 20,
    "MaxValidationSendsPerWindow": 10,
    "MaxResetSendsPerWindow": 10,
    "VerifyBlockMinutes": 15,
    "ResetSessionTokenExpiryMinutes": 10
  },

  "PasswordHashSettings": {
    "WorkFactor": 13
  },

  "DataProtectionSettings": {
    "UserDataPurpose": "LostAndFound.UserData"
  },

  "RateLimitSettings": {
    "RejectionMessage": "Too many requests. Please try again later.",
    "GlobalLimiter": {
      "PermitLimit": 120,
      "WindowMinutes": 1,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "ApiDefaultPolicy": {
      "PermitLimit": 40,
      "WindowMinutes": 1,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "AuthenticatedUserPolicy": {
      "PermitLimit": 300,
      "WindowMinutes": 5,
      "SegmentsPerWindow": 5,
      "QueueLimit": 0
    },
    "PerUserHeavyOpsPolicy": {
      "PermitLimit": 2,
      "QueueLimit": 0
    },
    "LoginPolicy": {
      "PermitLimit": 5,
      "WindowMinutes": 1,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "RegisterPolicy": {
      "PermitLimit": 3,
      "WindowMinutes": 5,
      "QueueLimit": 0
    },
    "RefreshPolicy": {
      "PermitLimit": 6,
      "WindowMinutes": 1,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "LogoutPolicy": {
      "PermitLimit": 10,
      "WindowMinutes": 1,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "HeavyOpsPolicy": {
      "PermitLimit": 8,
      "QueueLimit": 0
    },
    "BurstPerPathPolicy": {
      "PermitLimit": 5,
      "WindowMinutes": 1,
      "QueueLimit": 0
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "https://yourdomain.com",
      "https://localhost:4200",
      "https://localhost:3000"
    ]
  },

  "Csrf": {
    "HeaderName": "X-CSRF-TOKEN",
    "CookieName": "__Host-X-CSRF-COOKIE"
  },

  "CacheSettings": {
    "Provider": "Memory",
    "RedisConnection": ""
  },

  "UserThrottle": {
    "Enabled": true,
    "PermitLimit": 10,
    "WindowMinutes": 1,
    "ProtectedPaths": [
      "/api/v1/authenticate",
      "/api/v1/founditems/claim",
      "/api/v1/chat"
    ],
    "ExcludedPaths": [
      "/swagger",
      "/health",
      "/hubs"
    ]
  },

  "AdminSeed": {
    "Email": "admin@lostandfound.com",
    "Password": "Admin@1234",
    "UserName": "admin",
    "FullName": "System Administrator",
    "Phone": "01000000000",
    "NationalId": "00000000000000",
    "Address": "Cairo, Egypt",
    "Latitude": "30.044420",
    "Longitude": "31.235712",
    "ProfileImageUrl": ""
  }
}